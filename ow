#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export OW_DATA_DIR="${OW_DATA_DIR:-$repo_root/data/prototype}"
export OW_ASSET_DIR="${OW_ASSET_DIR:-$repo_root/data/runtime-spike}"
binary=$repo_root/target/release/ow
# A host release installed from published binaries builds nothing: use its own ow
# (RELEASE/bin/ow next to RELEASE/src), as its developer-image build does.
[[ -x $binary ]] || binary=$repo_root/../bin/ow
if [[ ! -x $binary ]]; then
  echo 'Build the local prototype first: bash scripts/setup-local.sh' >&2
  exit 1
fi
exec "$binary" "$@"
