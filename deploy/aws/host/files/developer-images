#!/bin/bash
# Builds each missing developer image (the dev user, SSH server, toolchains) in a
# disposable microVM, then publishes it into the worker's live asset set. The
# runner advertises it on its next heartbeat; nothing restarts.
set -euo pipefail
# The worker's release: its scripts match the asset set they write into.
cd /srv/ow/run/worker/src
guest=data/runtime-spike/guest
for profile in "$@"; do
  if [[ -f /etc/open-workspaces/store.json ]]; then
    python3 - "$profile" "$OW_ASSET_DIR" <<'PY'
import json, subprocess, sys
profile, assets = sys.argv[1:]
store = json.load(open('/etc/open-workspaces/store.json'))
pin = store['images'].get(profile)
if not pin:
    raise SystemExit(f'{profile}: store enabled but no pinned image configured')
subprocess.run(['/srv/ow/run/agent/bin/ow', 'image', 'pull', f"{profile}@{pin['version']}",
                '--from', store['url'], '--attempt', pin['attempt'], '--digest', pin['digest'],
                '--runner', '/srv/ow/.ow/runner', '--base-assets', assets], check=True)
PY
    echo "$profile: pulled pinned developer image; no worker restart"
    continue
  fi
  if python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1])).get("developer_user") else 1)' "$guest/$profile.json" 2>/dev/null; then
    echo "$profile: developer image present"
    continue
  fi
  if [[ ! -f $guest/$profile.ext4 ]]; then
    rm -rf "$guest/$profile.tmp" "$guest"/build-"$profile"-*
    # Its mkfs runs in a user namespace, which Ubuntu's AppArmor policy allows only
    # under the open-workspaces profile.
    aa-exec -p open-workspaces -- python3 experiments/runtime-spike/prepare-profiles.py "$profile"
  fi
  # Build roots live outside the release directory: a VM socket under
  # /srv/ow/releases/VERSION-COMMIT/src/data/... is longer than Linux allows.
  # build.py resolves the link, so its paths stay short.
  install -d -m 700 /srv/ow/build/dev-images
  if [[ ! -L data/dev-images ]]; then
    # Failed builds kept for inspection move along.
    [[ ! -d data/dev-images ]] || mv data/dev-images "/srv/ow/build/dev-images/from-release-$(date +%s)"
    ln -s /srv/ow/build/dev-images data/dev-images
  fi
  out=data/dev-images/out-$profile-$(date +%s)
  python3 experiments/guest-dev/build.py "$profile" --output-assets "$out"
  # Boxes clone the image when created, so replacing it leaves existing boxes alone.
  mv "$out/guest/$profile.ext4" "$guest/$profile.ext4"
  mv "$out/guest/$profile.json" "$guest/$profile.json"
  rm -rf "$out"
  for build in data/dev-images/build-*; do [[ -f $build/result.json ]] && rm -rf "$build"; done
  echo "$profile: developer image built"
done
